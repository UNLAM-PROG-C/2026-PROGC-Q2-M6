FROM ubuntu:24.04

ARG GODOT_VERSION=4.3
ARG GODOT_RELEASE=stable

ENV DEBIAN_FRONTEND=noninteractive
ENV GODOT_VERSION=${GODOT_VERSION}

RUN apt-get update \
  && apt-get install --no-install-recommends -y \
    ca-certificates \
    libasound2t64 \
    libfontconfig1 \
    libgl1 \
    libpulse0 \
    libxcursor1 \
    libxinerama1 \
    libxrandr2 \
    unzip \
    wget \
  && rm -rf /var/lib/apt/lists/*

RUN wget --quiet --output-document=/tmp/godot.zip \
    "https://downloads.godotengine.org/?version=${GODOT_VERSION}&flavor=${GODOT_RELEASE}&platform=linux.64&slug=linux.x86_64.zip" \
  && unzip -q /tmp/godot.zip -d /tmp/godot \
  && mv "/tmp/godot/Godot_v${GODOT_VERSION}-${GODOT_RELEASE}_linux.x86_64" /usr/local/bin/godot \
  && chmod +x /usr/local/bin/godot \
  && rm -rf /tmp/godot /tmp/godot.zip

WORKDIR /workspace

CMD ["godot", "--headless", "--path", "/workspace/cliente_godot", "--editor", "--quit"]
